# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/youtube-summarizer
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/youtube-summarizer

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRY=7d

# Application
NODE_ENV=development

# YouTube Transcript Service
# POST { "url": "<youtubeUrl>", "videoId": "<videoId>" }
# Expected response: { "transcript": "..." } or { "text": "..." }
YOUTUBE_TRANSCRIPT_API_URL=
YOUTUBE_TRANSCRIPT_API_KEY=

# AI Summarization Service
# OpenAI-compatible: https://api.openai.com/v1/chat/completions
# Custom API: POST { "text": "...", "language": "English" } -> { "summary": "..." }
AI_SUMMARIZATION_API_URL=
AI_SUMMARIZATION_API_KEY=
AI_MODEL=gpt-4o-mini
